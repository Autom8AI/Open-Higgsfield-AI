{
  "name": "open-higgsfield-ai",
  "description": "Open-source alternative to Higgsfield AI — AI image, video, cinema and lip sync studio",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/studio"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:studio": "cd packages/studio && npm run build",
    "setup": "npm install && npm run build:studio",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:all": "vite build && electron-builder --mac --win"
  },
  "build": {
    "appId": "ai.higgsfield.open",
    "productName": "Open Higgsfield AI",
    "copyright": "Copyright © 2025",
    "directories": { "output": "release" },
    "afterPack": "./afterPack.js",
    "files": ["dist/**/*", "electron/**/*"],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "gatekeeperAssess": false,
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "win": {
      "icon": "public/banner.png",
      "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }]
    }
  },
  "dependencies": {
    "axios": "^1.7.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "studio": "*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.6.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tailwindcss-v4": "npm:tailwindcss@^4.3.3",
    "vite": "^5.4.0"
  }
}
